DATABASE_URL=postgresql://user:password@host-pooler/database?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgresql://user:password@host/database?sslmode=verify-full
# Useful for local QA when DATABASE_URL points to an empty local Postgres instance.
USE_DATABASE_URL_UNPOOLED_FOR_RUNTIME=false
NEON_AUTH_BASE_URL=https://your-auth-host/neondb/auth
NEON_AUTH_JWKS_URL=https://your-auth-host/neondb/auth/.well-known/jwks.json

# OpenAI-compatible chat and embeddings endpoint. Keep these server-side only.
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_PROVIDER=openai_compatible
AI_MODEL=gpt-4.1-mini
AI_DISABLE_REASONING=false
AI_REQUEST_TIMEOUT_MS=180000
AI_MAX_OUTPUT_TOKENS=900
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
AI_STRUCTURED_OUTPUT_MODE=json_schema
ALLOW_UNGROUNDED_ANSWERS=false
EMBEDDING_BATCH_SIZE=50

# Optional: keep chat on Ollama and embeddings on a separate 1536-dimensional provider.
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=

# Set this to the final Site origin instead of * in production.
CORS_ALLOWED_ORIGIN=https://your-site.example

# Local E2E only. Ignored in production and accepted only on loopback requests.
NABAHA_LOCAL_E2E_USER_ID=
NABAHA_LOCAL_E2E_TOKEN=

# Private source-document storage.
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
